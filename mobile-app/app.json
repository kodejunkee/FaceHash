{
  "expo": {
    "name": "FaceHash",
    "slug": "facehash-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a1a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to capture your face for biometric authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jaydeveloper.facehashapp"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "This app requires camera access to capture your face for biometric authentication."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "71cdd7a2-6869-414f-9783-a6ad72647bb8"
      }
    }
  }
}
